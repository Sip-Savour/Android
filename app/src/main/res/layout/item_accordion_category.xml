<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="@dimen/margin_small">

    <!-- Header clickable -->
    <LinearLayout
        android:id="@+id/layoutCategoryHeader"
        android:layout_width="match_parent"
        android:layout_height="@dimen/accordion_header_height"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="@dimen/padding_medium"
        android:paddingEnd="@dimen/padding_medium"
        android:background="@drawable/bg_accordion_header_ripple"
        android:clickable="true"
        android:focusable="true">

        <!-- Title (centré) -->
        <TextView
            android:id="@+id/tvCategoryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/playfair_display"
            android:textSize="@dimen/text_title_medium"
            android:textColor="@color/primary"
            android:textStyle="bold" />

        <!-- Expand icon -->
        <ImageView
            android:id="@+id/ivExpandIcon"
            android:layout_width="@dimen/accordion_icon_size"
            android:layout_height="@dimen/accordion_icon_size"
            android:layout_marginStart="@dimen/margin_small"
            android:src="@drawable/ic_chevron_down"
            android:contentDescription="@null" />

    </LinearLayout>

    <!-- Chips container -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupFlavors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/padding_medium"
        android:paddingEnd="@dimen/padding_medium"
        android:paddingTop="@dimen/padding_small"
        android:paddingBottom="@dimen/padding_medium"
        android:visibility="gone"
        app:chipSpacingHorizontal="@dimen/margin_small"
        app:chipSpacingVertical="@dimen/margin_tiny"
        app:singleSelection="false" />

</LinearLayout>