<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/margin_medium"
    android:layout_marginEnd="@dimen/margin_medium"
    android:layout_marginBottom="@dimen/margin_small"
    app:cardCornerRadius="@dimen/radius_medium"
    app:cardElevation="@dimen/elevation_low"
    app:cardBackgroundColor="@color/surface"
    app:strokeWidth="0dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:transitionName="favorite_item">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/padding_small">

        <!-- Wine image -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/favorite_image_size"
            android:layout_height="@dimen/favorite_image_size"
            app:cardCornerRadius="@dimen/radius_small"
            app:cardElevation="@dimen/elevation_low"
            app:strokeWidth="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_favorite_image">

                <ImageView
                    android:id="@+id/ivFavoriteWine"
                    android:layout_width="48dp"
                    android:layout_height="68dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_wine_red"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/cd_wine_image" />

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Name -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/margin_medium"
            android:layout_marginEnd="@dimen/margin_small"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFavoriteName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/playfair_display"
                android:textSize="@dimen/text_body"
                android:textColor="@color/on_surface"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- Chevron doré -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="@dimen/margin_small"
            android:src="@drawable/ic_chevron_down"
            android:rotation="-90"
            app:tint="@color/secondary"
            android:contentDescription="@null" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
