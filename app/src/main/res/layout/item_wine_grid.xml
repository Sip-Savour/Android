<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cv_wine_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_pink_beige">

        <!-- Image du vin avec overlay -->
        <RelativeLayout
            android:id="@+id/wine_image_container"
            android:layout_width="match_parent"
            android:layout_height="180dp">

            <ImageView
                android:id="@+id/iv_wine_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/wine_bottle_placeholder"
                android:contentDescription="@string/wine_image" />

            <!-- Overlay gradient -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/gradient_overlay_bottom" />

            <!-- Badge Type -->
            <TextView
                android:id="@+id/tv_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_margin="12dp"
                android:background="@drawable/badge_rounded"
                android:backgroundTint="@color/wine_red"
                android:fontFamily="serif"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="Rouge"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:elevation="2dp" />

            <!-- Bouton favori -->
            <ImageView
                android:id="@+id/iv_favorite"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true"
                android:layout_margin="12dp"
                android:padding="6dp"
                android:src="@drawable/ic_favorite_outline"
                android:background="@drawable/circle_background"
                android:backgroundTint="#80FFFFFF"
                android:contentDescription="@string/favorite"
                app:tint="@color/burgundy"
                android:elevation="2dp" />

        </RelativeLayout>

        <!-- Contenu texte -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/wine_image_container"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_wine_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:fontFamily="serif"
                android:text="Château Margaux"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:maxLines="2"
                android:text="Un vin élégant avec des notes de cassis"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp"
                android:alpha="0.8" />

            <!-- Rating et prix -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_star"
                    android:contentDescription="@string/rating"
                    app:tint="@color/gold" />

                <TextView
                    android:id="@+id/tv_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="serif"
                    android:text="4.5"
                    android:textColor="@color/burgundy_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="45€"
                    android:textColor="@color/burgundy"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

</androidx.cardview.widget.CardView>