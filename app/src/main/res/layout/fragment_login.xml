<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/header_bar_height"
            android:background="@drawable/bg_header_gradient">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/login_title"
                    android:fontFamily="@font/playfair_display"
                    android:textSize="@dimen/text_headline_medium"
                    android:textColor="@color/header_text"
                    android:textStyle="bold|italic" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/login_subtitle"
                    android:fontFamily="@font/lato"
                    android:textSize="@dimen/text_label"
                    android:textColor="@color/header_subtitle"
                    android:letterSpacing="0.06"
                    android:textAllCaps="true" />

            </LinearLayout>

        </FrameLayout>

        <!-- Contenu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="@dimen/padding_xlarge"
            android:paddingEnd="@dimen/padding_xlarge"
            android:paddingTop="@dimen/padding_xlarge"
            android:paddingBottom="@dimen/padding_xlarge">

            <!-- Avatar doré -->
            <FrameLayout
                android:layout_width="@dimen/person_icon_size"
                android:layout_height="@dimen/person_icon_size">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_person_circle" />

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_person"
                    app:tint="@color/primary"
                    android:contentDescription="@null" />

            </FrameLayout>

            <!-- Ornement doré -->
            <View
                android:layout_width="@dimen/divider_decorative_width"
                android:layout_height="@dimen/divider_height"
                android:layout_marginTop="@dimen/margin_large"
                android:background="@drawable/bg_decorative_divider" />

            <!-- Email -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_large"
                android:hint="@string/login_email_hint"
                style="@style/Widget.SipSavour.PillInput">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:inputType="textEmailAddress"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="yes"
                    android:autofillHints="emailAddress"
                    style="@style/Widget.SipSavour.PillInput.EditText" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:hint="@string/login_password_hint"
                app:endIconMode="password_toggle"
                style="@style/Widget.SipSavour.PillInput">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:inputType="textPassword"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="yes"
                    android:autofillHints="password"
                    style="@style/Widget.SipSavour.PillInput.EditText" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Error -->
            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:textColor="@color/error"
                android:textSize="@dimen/text_caption"
                android:fontFamily="@font/lato"
                android:visibility="gone"
                android:gravity="center" />

            <!-- Login button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/margin_large"
                android:text="@string/login_button"
                style="@style/Widget.SipSavour.Button" />

            <!-- Loading -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/secondary"
                app:trackColor="@color/surface_variant"
                app:trackCornerRadius="2dp" />

            <!-- Forgot password -->
            <TextView
                android:id="@+id/tvForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_xlarge"
                android:text="@string/login_forgot_password"
                android:fontFamily="@font/playfair_display"
                android:textSize="@dimen/text_body"
                android:textColor="@color/primary"
                android:textStyle="italic"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground" />

            <!-- Ornement doré -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="@dimen/margin_large">

                <View
                    android:layout_width="40dp"
                    android:layout_height="1dp"
                    android:background="@color/divider_gold" />

                <View
                    android:layout_width="@dimen/ornament_dot_size"
                    android:layout_height="@dimen/ornament_dot_size"
                    android:layout_marginStart="@dimen/margin_small"
                    android:layout_marginEnd="@dimen/margin_small"
                    android:background="@drawable/bg_ornament_dot" />

                <View
                    android:layout_width="40dp"
                    android:layout_height="1dp"
                    android:background="@color/divider_gold" />

            </LinearLayout>

            <!-- Register link -->
            <TextView
                android:id="@+id/btnGoToRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:text="@string/login_no_account"
                android:fontFamily="@font/playfair_display"
                android:textSize="@dimen/text_body"
                android:textColor="@color/secondary_dark"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
