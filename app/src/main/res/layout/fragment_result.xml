<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_bar_height"
        android:background="@drawable/bg_header_gradient">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/info_title"
                android:fontFamily="@font/playfair_display"
                android:textSize="@dimen/text_headline_medium"
                android:textColor="@color/header_text"
                android:textStyle="bold|italic" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/result_title"
                android:fontFamily="@font/lato"
                android:textSize="@dimen/text_label"
                android:textColor="@color/header_subtitle"
                android:letterSpacing="0.06"
                android:textAllCaps="true" />

        </LinearLayout>

    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_medium">

            <!-- Wine Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="@dimen/elevation_high"
                app:strokeWidth="0dp"
                android:transitionName="wine_detail_card">

                <FrameLayout
                    android:id="@+id/wineCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_gradient_rose"
                    android:padding="@dimen/padding_large">

                    <ImageView
                        android:layout_width="@dimen/wine_fork_icon_size"
                        android:layout_height="@dimen/wine_fork_icon_size"
                        android:layout_gravity="top|end"
                        android:src="@drawable/ic_wine_fork"
                        android:alpha="0.5"
                        android:contentDescription="@null" />

                    <ImageButton
                        android:id="@+id/fabFavorite"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="bottom|end"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_heart_outline"
                        app:tint="@color/secondary"
                        android:scaleType="centerInside"
                        android:contentDescription="@string/cd_favorite_button" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginEnd="56dp"
                        android:layout_marginBottom="48dp">

                        <TextView
                            android:id="@+id/tvTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/margin_medium"
                            tools:text="Nom du vin"
                            style="@style/TextAppearance.SipSavour.WineTitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/info_cepage_label"
                            style="@style/TextAppearance.SipSavour.WineLabel" />

                        <TextView
                            android:id="@+id/tvCepage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            style="@style/TextAppearance.SipSavour.WineValue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_medium"
                            android:text="@string/info_description_label"
                            style="@style/TextAppearance.SipSavour.WineLabel" />

                        <TextView
                            android:id="@+id/tvDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            style="@style/TextAppearance.SipSavour.WineBody" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_medium"
                            android:text="@string/info_type_label"
                            style="@style/TextAppearance.SipSavour.WineLabel" />

                        <TextView
                            android:id="@+id/tvType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            style="@style/TextAppearance.SipSavour.WineValue" />

                    </LinearLayout>

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_xlarge" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>