<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header décoratif -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_bar_height"
        android:background="@drawable/bg_header_gradient">

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/weekly_title"
            android:fontFamily="@font/playfair_display"
            android:textSize="@dimen/text_headline_medium"
            android:textColor="@color/header_text"
            android:textStyle="bold|italic" />

    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_medium">

            <!-- === WINE CARD === -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_large"
                app:cardElevation="@dimen/elevation_medium"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_gradient_rose"
                    android:padding="@dimen/padding_large">

                    <!-- Wine icon -->
                    <ImageView
                        android:layout_width="@dimen/wine_fork_icon_size"
                        android:layout_height="@dimen/wine_fork_icon_size"
                        android:layout_gravity="end"
                        android:src="@drawable/ic_wine_fork"
                        android:contentDescription="@null" />

                    <!-- Cépage -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/info_cepage_label"
                            style="@style/TextAppearance.SipSavour.WineLabel" />

                        <TextView
                            android:id="@+id/tvCepage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_small"
                            style="@style/TextAppearance.SipSavour.WineValue" />

                    </LinearLayout>

                    <!-- Description -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:text="@string/info_description_label"
                        style="@style/TextAppearance.SipSavour.WineLabel" />

                    <TextView
                        android:id="@+id/tvDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_small"
                        style="@style/TextAppearance.SipSavour.WineBody" />

                    <!-- Type -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/info_type_label"
                            style="@style/TextAppearance.SipSavour.WineLabel" />

                        <TextView
                            android:id="@+id/tvType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_small"
                            style="@style/TextAppearance.SipSavour.WineValue" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- === MEAL CARD === -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                app:cardCornerRadius="@dimen/radius_large"
                app:cardElevation="@dimen/elevation_medium"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_card_gradient_rose"
                    android:padding="@dimen/padding_large"
                    android:gravity="center_vertical">

                    <!-- Meal icon -->
                    <ImageView
                        android:layout_width="@dimen/wine_fork_icon_size"
                        android:layout_height="@dimen/wine_fork_icon_size"
                        android:src="@drawable/ic_wine_fork"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/margin_medium"
                        android:orientation="vertical">

                        <!-- Meal name -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/weekly_meal_label"
                                android:textStyle="bold"
                                style="@style/TextAppearance.SipSavour.Body" />

                            <TextView
                                android:id="@+id/tvMealName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/margin_small"
                                style="@style/TextAppearance.SipSavour.Body" />

                        </LinearLayout>

                        <!-- Ingredients -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_small"
                            android:text="@string/weekly_ingredient_label"
                            android:textStyle="bold"
                            style="@style/TextAppearance.SipSavour.Body" />

                        <TextView
                            android:id="@+id/tvIngredients"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_tiny"
                            style="@style/TextAppearance.SipSavour.BodyLight" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_xlarge" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>