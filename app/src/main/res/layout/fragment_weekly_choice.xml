<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_bar_height"
        android:background="@drawable/bg_header_gradient">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/weekly_title"
                android:fontFamily="@font/playfair_display"
                android:textSize="@dimen/text_headline_medium"
                android:textColor="@color/header_text"
                android:textStyle="bold|italic" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/home_daily_subtitle"
                android:fontFamily="@font/lato"
                android:textSize="@dimen/text_label"
                android:textColor="@color/header_subtitle"
                android:letterSpacing="0.06"
                android:textAllCaps="true" />

        </LinearLayout>

    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_medium">

            <!-- Wine Card (CLIQUABLE) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="@dimen/elevation_medium"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_gradient_rose"
                    android:padding="@dimen/padding_large">

                    <!-- Indicateur de clic -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="@dimen/wine_fork_icon_size"
                            android:layout_height="@dimen/wine_fork_icon_size"
                            android:src="@drawable/ic_wine_fork"
                            android:alpha="0.5"
                            android:contentDescription="@null" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/weekly_tap_for_details"
                            android:fontFamily="@font/lato"
                            android:textSize="11sp"
                            android:textColor="@color/secondary"
                            android:alpha="0.8"
                            android:drawableEnd="@drawable/ic_arrow_right_small"
                            android:drawablePadding="4dp"
                            app:drawableTint="@color/secondary" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:text="@string/info_cepage_label"
                        style="@style/TextAppearance.SipSavour.WineLabel" />

                    <TextView
                        android:id="@+id/tvCepage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        style="@style/TextAppearance.SipSavour.WineValue" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:text="@string/info_description_label"
                        style="@style/TextAppearance.SipSavour.WineLabel" />

                    <TextView
                        android:id="@+id/tvDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxLines="4"
                        android:ellipsize="end"
                        style="@style/TextAppearance.SipSavour.WineBody" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:text="@string/info_type_label"
                        style="@style/TextAppearance.SipSavour.WineLabel" />

                    <TextView
                        android:id="@+id/tvType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        style="@style/TextAppearance.SipSavour.WineValue" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Ornement doré -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="@dimen/margin_large"
                android:layout_marginBottom="@dimen/margin_large">

                <View
                    android:layout_width="30dp"
                    android:layout_height="1dp"
                    android:background="@color/divider_gold" />

                <View
                    android:layout_width="@dimen/ornament_dot_size"
                    android:layout_height="@dimen/ornament_dot_size"
                    android:layout_marginStart="@dimen/margin_small"
                    android:layout_marginEnd="@dimen/margin_small"
                    android:background="@drawable/bg_ornament_dot" />

                <View
                    android:layout_width="30dp"
                    android:layout_height="1dp"
                    android:background="@color/divider_gold" />

            </LinearLayout>

            <!-- Meal Card (CLIQUABLE) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMeal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="@dimen/elevation_medium"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_gradient_rose"
                    android:padding="@dimen/padding_large">

                    <!-- Header avec indicateur de clic -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="@dimen/wine_fork_icon_size"
                            android:layout_height="@dimen/wine_fork_icon_size"
                            android:src="@drawable/ic_wine_fork"
                            android:alpha="0.5"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_small"
                            android:text="@string/weekly_meal_label"
                            style="@style/TextAppearance.SipSavour.WineLabel" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/weekly_tap_for_recipe"
                            android:fontFamily="@font/lato"
                            android:textSize="11sp"
                            android:textColor="@color/secondary"
                            android:alpha="0.8"
                            android:drawableEnd="@drawable/ic_arrow_right_small"
                            android:drawablePadding="4dp"
                            app:drawableTint="@color/secondary" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvMealName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_small"
                        style="@style/TextAppearance.SipSavour.WineValue" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:text="@string/weekly_ingredient_label"
                        style="@style/TextAppearance.SipSavour.WineLabel" />

                    <TextView
                        android:id="@+id/tvIngredients"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="5"
                        android:ellipsize="end"
                        style="@style/TextAppearance.SipSavour.WineBody" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_xlarge" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>