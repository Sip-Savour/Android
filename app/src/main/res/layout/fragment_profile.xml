<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <include layout="@layout/layout_header_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="@dimen/padding_large">

                <!-- Avatar + Edit -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium">

                    <FrameLayout
                        android:layout_width="@dimen/person_icon_size"
                        android:layout_height="@dimen/person_icon_size">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_person_circle" />

                        <ImageView
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_person"
                            android:tint="@color/primary"
                            android:contentDescription="@null" />

                    </FrameLayout>

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/fabEdit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_marginEnd="-48dp"
                        app:srcCompat="@drawable/ic_edit_pen"
                        app:fabSize="mini"
                        app:tint="@color/primary"
                        app:backgroundTint="@color/surface"
                        app:elevation="@dimen/elevation_low"
                        android:contentDescription="@string/profile_edit" />

                </FrameLayout>

                <!-- Divider -->
                <View
                    android:layout_width="200dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:background="@color/primary" />

                <!-- Name -->
                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:fontFamily="@font/playfair_display"
                    android:textSize="@dimen/text_title_large"
                    android:textColor="@color/on_background" />

                <!-- Email -->
                <TextView
                    android:id="@+id/tvProfileEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:fontFamily="@font/lato"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/on_background" />

                <!-- DOB -->
                <TextView
                    android:id="@+id/tvProfileDob"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:fontFamily="@font/lato"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/on_background" />

                <!-- Divider -->
                <View
                    android:layout_width="200dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/margin_large"
                    android:background="@color/primary" />

                <!-- Preferences button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPreferences"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="@dimen/margin_large"
                    android:text="@string/profile_preferences"
                    android:fontFamily="@font/playfair_display"
                    android:textSize="@dimen/text_title_medium"
                    android:textColor="@color/btn_gradient_text"
                    android:textStyle="italic"
                    app:backgroundTint="@null"
                    android:background="@drawable/bg_button_gradient_selector"
                    app:rippleColor="#33FFFFFF"
                    app:cornerRadius="28dp"
                    app:elevation="@dimen/elevation_medium"
                    android:stateListAnimator="@null" />

                <!-- History button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHistory"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:text="@string/profile_history"
                    android:fontFamily="@font/playfair_display"
                    android:textSize="@dimen/text_title_medium"
                    android:textColor="@color/btn_gradient_text"
                    android:textStyle="italic"
                    app:backgroundTint="@null"
                    android:background="@drawable/bg_button_gradient_selector"
                    app:rippleColor="#33FFFFFF"
                    app:cornerRadius="28dp"
                    app:elevation="@dimen/elevation_medium"
                    android:stateListAnimator="@null" />

                <!-- Divider -->
                <View
                    android:layout_width="200dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/margin_large"
                    android:background="@color/primary" />

            </LinearLayout>

        </ScrollView>

        <!-- Bottom actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/padding_medium"
            android:paddingEnd="@dimen/padding_medium"
            android:paddingBottom="@dimen/padding_small">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_settings_sliders"
                app:fabSize="mini"
                app:tint="@color/primary"
                app:backgroundTint="@color/surface"
                app:elevation="@dimen/elevation_low"
                android:contentDescription="Paramètres" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabLogout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_logout_door"
                app:fabSize="mini"
                app:tint="@color/primary"
                app:backgroundTint="@color/surface"
                app:elevation="@dimen/elevation_low"
                android:contentDescription="@string/profile_logout" />

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>