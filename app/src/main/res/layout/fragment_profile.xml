<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header décoratif -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_bar_height"
        android:background="@drawable/bg_header_gradient">

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/profile_account_title"
            android:fontFamily="@font/playfair_display"
            android:textSize="@dimen/text_headline_medium"
            android:textColor="@color/header_text"
            android:textStyle="bold|italic" />

    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="@dimen/padding_large">

            <!-- Avatar + Edit icon -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium">

                <!-- Avatar circle -->
                <FrameLayout
                    android:layout_width="@dimen/profile_avatar_size"
                    android:layout_height="@dimen/profile_avatar_size">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_person_circle" />

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_person"
                        android:contentDescription="@null"
                        app:tint="@color/primary" />

                </FrameLayout>

                <!-- Edit icon (simple ImageButton, pas FAB) -->
                <ImageButton
                    android:id="@+id/fabEdit"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="top|end"
                    android:layout_marginEnd="-44dp"
                    android:layout_marginTop="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_edit_pen"
                    app:tint="@color/primary"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/profile_edit" />

            </FrameLayout>

            <!-- Divider -->
            <View
                android:layout_width="200dp"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/margin_medium"
                android:background="@color/primary" />

            <!-- Name -->
            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:fontFamily="@font/playfair_display"
                android:textSize="@dimen/text_title_large"
                android:textColor="@color/on_background"
                android:textStyle="bold" />

            <!-- Email -->
            <TextView
                android:id="@+id/tvProfileEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:fontFamily="@font/lato"
                android:textSize="@dimen/text_body"
                android:textColor="@color/on_background" />

            <!-- DOB -->
            <TextView
                android:id="@+id/tvProfileDob"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:fontFamily="@font/lato"
                android:textSize="@dimen/text_body"
                android:textColor="@color/on_background" />

            <!-- Divider -->
            <View
                android:layout_width="200dp"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/margin_large"
                android:background="@color/primary" />

            <!-- Preferences button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPreferences"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/margin_large"
                android:text="@string/profile_preferences"
                android:fontFamily="@font/playfair_display"
                android:textSize="@dimen/text_title_medium"
                android:textColor="@color/btn_gradient_text"
                android:textStyle="italic"
                app:backgroundTint="@null"
                android:background="@drawable/bg_button_gradient_selector"
                app:rippleColor="#33FFFFFF"
                app:cornerRadius="@dimen/radius_xlarge"
                app:elevation="@dimen/elevation_medium"
                android:stateListAnimator="@null" />

            <!-- History button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHistory"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/margin_medium"
                android:text="@string/profile_history"
                android:fontFamily="@font/playfair_display"
                android:textSize="@dimen/text_title_medium"
                android:textColor="@color/btn_gradient_text"
                android:textStyle="italic"
                app:backgroundTint="@null"
                android:background="@drawable/bg_button_gradient_selector"
                app:rippleColor="#33FFFFFF"
                app:cornerRadius="@dimen/radius_xlarge"
                app:elevation="@dimen/elevation_medium"
                android:stateListAnimator="@null" />

            <!-- Divider -->
            <View
                android:layout_width="200dp"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/margin_large"
                android:background="@color/primary" />

        </LinearLayout>

    </ScrollView>

    <!-- Bottom actions (Settings + Logout) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/padding_medium"
        android:paddingEnd="@dimen/padding_medium"
        android:paddingTop="@dimen/padding_small"
        android:paddingBottom="@dimen/padding_small">

        <ImageButton
            android:id="@+id/fabSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings_sliders"
            app:tint="@color/primary"
            android:scaleType="centerInside"
            android:contentDescription="@string/profile_settings" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/fabLogout"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_logout_door"
            app:tint="@color/primary"
            android:scaleType="centerInside"
            android:contentDescription="@string/profile_logout" />

    </LinearLayout>

</LinearLayout>