<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/beige_light">

    <!-- Header avec dégradé -->
    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@drawable/gradient_header">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="serif"
            android:text="@string/nos_vins"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iv_toggle_view"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:padding="12dp"
            android:src="@drawable/ic_list_view"
            android:contentDescription="@string/toggle_view"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white" />

    </RelativeLayout>

    <!-- Contenu principal -->
    <LinearLayout
        android:id="@+id/content_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_navigation"
        android:layout_below="@id/header"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp">

        <!-- Barre de recherche moderne -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="8dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@color/white">

                <ImageView
                    android:id="@+id/iv_search_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="20dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="@string/search"
                    app:tint="@color/burgundy" />

                <SearchView
                    android:id="@+id/search_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toEndOf="@id/iv_search_icon"
                    android:layout_marginStart="8dp"
                    android:background="@android:color/transparent"
                    android:iconifiedByDefault="false"
                    android:queryBackground="@android:color/transparent"
                    android:queryHint="@string/rechercher_un_vin" />

            </RelativeLayout>

        </androidx.cardview.widget.CardView>

        <!-- Titre section filtres -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_filter"
                android:contentDescription="@string/filter"
                app:tint="@color/burgundy_dark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="serif"
                android:text="@string/filtrer_par_type"
                android:textColor="@color/burgundy_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Chips de filtrage -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:chipSpacing="8dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_tous"
                    style="@style/FilterChipStyleModern"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/tous"
                    app:chipIcon="@drawable/ic_wine_all"
                    app:chipIconSize="20dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_rouge"
                    style="@style/FilterChipStyleModern"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rouge"
                    app:chipIcon="@drawable/ic_wine_red"
                    app:chipIconSize="20dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_blanc"
                    style="@style/FilterChipStyleModern"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/blanc"
                    app:chipIcon="@drawable/ic_wine_white"
                    app:chipIconSize="20dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_rose"
                    style="@style/FilterChipStyleModern"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rose"
                    app:chipIcon="@drawable/ic_wine_rose"
                    app:chipIconSize="20dp" />

            </com.google.android.material.chip.ChipGroup>

        </HorizontalScrollView>

        <!-- Nombre de résultats -->
        <TextView
            android:id="@+id/tv_result_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFamily="serif"
            android:text="@string/result_count"
            android:textColor="@color/burgundy"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- RecyclerView Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_wine_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <!-- Message vide -->
        <LinearLayout
            android:id="@+id/empty_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginBottom="24dp"
                android:src="@drawable/ic_empty_wine"
                android:contentDescription="@string/no_results"
                app:tint="@color/burgundy_light"
                android:alpha="0.5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="@string/aucun_vin_trouve"
                android:textColor="@color/burgundy"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="serif"
                android:text="@string/essayez_autre_recherche"
                android:textColor="@color/burgundy_light"
                android:textSize="16sp"
                android:gravity="center"
                android:paddingStart="32dp"
                android:paddingEnd="32dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/gradient_bottom_nav"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>