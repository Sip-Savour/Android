<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- HEADER - Version premium avec titre + sous-titre                 -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_bar_height"
        android:background="@drawable/bg_header_gradient">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/category_title"
                android:fontFamily="@font/playfair_display"
                android:textSize="@dimen/text_headline_medium"
                android:textColor="@color/header_text"
                android:textStyle="bold|italic" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/category_subtitle"
                android:fontFamily="@font/lato"
                android:textSize="@dimen/text_label"
                android:textColor="@color/header_subtitle"
                android:letterSpacing="0.06"
                android:textAllCaps="true" />

        </LinearLayout>

    </FrameLayout>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- CONTENU SCROLLABLE                                               -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_medium">

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- ÉTAPE 1 — Base du plat                                   -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/margin_small">

                <FrameLayout
                    android:layout_width="@dimen/step_number_size"
                    android:layout_height="@dimen/step_number_size">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_step_number" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="1"
                        style="@style/TextAppearance.SipSavour.StepNumber" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/margin_small"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/meal_step_1"
                        style="@style/TextAppearance.SipSavour.StepTitle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/meal_step_1_hint"
                        style="@style/TextAppearance.SipSavour.StepSubtitle" />

                </LinearLayout>

            </LinearLayout>

            <!-- ═══ Ornement doré ═══ -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBaseOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="@dimen/margin_large"
                android:layout_marginBottom="@dimen/margin_large">

                <View
                    android:layout_width="30dp"
                    android:layout_height="1dp"
                    android:background="@color/divider_gold" />

                <View
                    android:layout_width="@dimen/ornament_dot_size"
                    android:layout_height="@dimen/ornament_dot_size"
                    android:layout_marginStart="@dimen/margin_small"
                    android:layout_marginEnd="@dimen/margin_small"
                    android:background="@drawable/bg_ornament_dot" />

                <View
                    android:layout_width="30dp"
                    android:layout_height="1dp"
                    android:background="@color/divider_gold" />

            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- ÉTAPE 2 — Profil gustatif                                -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/margin_small">

                <FrameLayout
                    android:layout_width="@dimen/step_number_size"
                    android:layout_height="@dimen/step_number_size">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_step_number" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="2"
                        style="@style/TextAppearance.SipSavour.StepNumber" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/margin_small"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/meal_step_2"
                        style="@style/TextAppearance.SipSavour.StepTitle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/meal_step_2_hint"
                        style="@style/TextAppearance.SipSavour.StepSubtitle" />

                </LinearLayout>

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTasteOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- ═══ Ornement doré ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="@dimen/margin_large"
                android:layout_marginBottom="@dimen/margin_large">

                <View
                    android:layout_width="30dp"
                    android:layout_height="1dp"
                    android:background="@color/divider_gold" />

                <View
                    android:layout_width="@dimen/ornament_dot_size"
                    android:layout_height="@dimen/ornament_dot_size"
                    android:layout_marginStart="@dimen/margin_small"
                    android:layout_marginEnd="@dimen/margin_small"
                    android:background="@drawable/bg_ornament_dot" />

                <View
                    android:layout_width="30dp"
                    android:layout_height="1dp"
                    android:background="@color/divider_gold" />

            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- ÉTAPE 3 — Couleur (optionnel)                            -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/margin_small">

                <FrameLayout
                    android:layout_width="@dimen/step_number_size"
                    android:layout_height="@dimen/step_number_size">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_step_number_inactive" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="3"
                        android:fontFamily="@font/playfair_display"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/step_inactive_text"
                        android:textStyle="bold" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/margin_small"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/meal_step_3"
                        style="@style/TextAppearance.SipSavour.StepTitle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/meal_ai_hint"
                        style="@style/TextAppearance.SipSavour.StepSubtitle" />

                </LinearLayout>

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvColorOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- BOUTON — Style premium                                   -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFindWine"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/margin_xlarge"
                android:layout_marginBottom="@dimen/margin_xlarge"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                android:text="@string/meal_find_wine"
                android:enabled="false"
                style="@style/Widget.SipSavour.Button" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>