<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- === Header gradient === -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/header_height_small"
            android:background="@drawable/bg_gradient_wine">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="@dimen/padding_large"
                android:paddingEnd="@dimen/padding_large">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/category_title"
                    android:textColor="@color/on_primary"
                    android:fontFamily="@font/playfair_display"
                    android:textSize="@dimen/text_headline_medium"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_tiny"
                    android:text="@string/category_subtitle"
                    android:textColor="#CCFFFFFF"
                    android:fontFamily="@font/lato_light"
                    android:textSize="@dimen/text_body" />

            </LinearLayout>

        </FrameLayout>

        <!-- === Catégories grille === -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-20dp"
            android:paddingStart="@dimen/padding_medium"
            android:paddingEnd="@dimen/padding_medium"
            android:clipToPadding="false"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="2" />

        <!-- === Sous-catégories === -->
        <TextView
            android:id="@+id/tvSubcategoryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_large"
            android:layout_marginStart="@dimen/margin_medium"
            android:text="@string/subcategory_title"
            android:visibility="gone"
            style="@style/TextAppearance.SipSavour.TitleMedium" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupSubcategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:paddingStart="@dimen/padding_medium"
            android:paddingEnd="@dimen/padding_medium"
            android:visibility="gone"
            app:singleSelection="true"
            app:chipSpacingHorizontal="@dimen/margin_small"
            app:chipSpacingVertical="@dimen/margin_small" />

        <!-- === Bouton suivant === -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNextToFlavor"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_margin="@dimen/margin_medium"
            android:layout_marginTop="@dimen/margin_large"
            android:text="@string/flavor_next_button"
            android:enabled="false"
            style="@style/Widget.SipSavour.Button" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/margin_xlarge" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>