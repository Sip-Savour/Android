<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header décoratif -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_bar_height"
        android:background="@drawable/bg_header_gradient">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/category_title"
            android:fontFamily="@font/playfair_display"
            android:textSize="@dimen/text_headline_medium"
            android:textColor="@color/header_text"
            android:textStyle="bold|italic" />

    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_medium">

            <!-- Sous-titre -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/category_subtitle"
                android:fontFamily="@font/lato"
                android:textSize="@dimen/text_body"
                android:textColor="@color/on_surface_variant"
                android:gravity="center"
                android:layout_marginBottom="@dimen/margin_large" />

            <!-- Catégories en grille -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2" />

            <!-- Sous-catégories -->
            <TextView
                android:id="@+id/tvSubcategoryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_large"
                android:text="@string/subcategory_title"
                android:visibility="gone"
                style="@style/TextAppearance.SipSavour.TitleMedium" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupSubcategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:visibility="gone"
                app:singleSelection="true"
                app:chipSpacingHorizontal="@dimen/margin_small"
                app:chipSpacingVertical="@dimen/margin_small" />

            <!-- Bouton suivant -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNextToFlavor"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/margin_xlarge"
                android:text="@string/flavor_next_button"
                android:enabled="false"
                android:fontFamily="@font/playfair_display"
                android:textSize="@dimen/text_title_medium"
                android:textColor="@color/btn_gradient_text"
                android:textStyle="italic"
                app:backgroundTint="@null"
                android:background="@drawable/bg_button_gradient_selector"
                app:rippleColor="#33FFFFFF"
                app:cornerRadius="@dimen/radius_xlarge"
                app:elevation="@dimen/elevation_medium"
                android:stateListAnimator="@null" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_xlarge" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>