<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_gold">

    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="@color/weekly_gradient_start"
                android:centerColor="@color/weekly_gradient_center"
                android:endColor="@color/weekly_gradient_end" />
        </shape>
    </item>

</ripple>