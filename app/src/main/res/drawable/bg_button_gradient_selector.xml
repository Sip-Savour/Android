<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_disabled_bg" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="@color/btn_gradient_pressed_start"
                android:endColor="@color/btn_gradient_pressed_end" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="@color/btn_gradient_start"
                android:endColor="@color/btn_gradient_end" />
            <corners android:radius="28dp" />
        </shape>
    </item>

</selector>