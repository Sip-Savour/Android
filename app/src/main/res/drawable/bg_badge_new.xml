<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Ombre douce -->
    <item
        android:bottom="-1dp"
        android:left="1dp"
        android:right="-1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/weekly_badge_shadow" />
        </shape>
    </item>

    <!-- Fond dégradé doré -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="@color/weekly_badge_bg_start"
                android:endColor="@color/weekly_badge_bg_end" />
        </shape>
    </item>

</layer-list>