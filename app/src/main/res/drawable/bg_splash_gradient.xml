<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base gradient bordeaux → doré -->
    <item>
        <shape>
            <gradient
                android:type="linear"
                android:angle="180"
                android:startColor="@color/primary"
                android:centerColor="@color/primary_light"
                android:endColor="@color/secondary" />
        </shape>
    </item>

    <!-- Overlay crème en bas pour adoucir -->
    <item>
        <shape>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#00FDF6EC"
                android:endColor="#40FDF6EC" />
        </shape>
    </item>

</layer-list>