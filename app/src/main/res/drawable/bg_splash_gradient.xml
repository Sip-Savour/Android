<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Gradient rose/bordeaux doux -->
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="800dp"
                android:centerX="0.5"
                android:centerY="0.4"
                android:startColor="#9B5070"
                android:centerColor="#8B4060"
                android:endColor="#7A3050" />
        </shape>
    </item>

    <!-- Overlay crème en bas pour adoucir -->
    <item>
        <shape>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#00F5EBE0"
                android:endColor="#40F5EBE0" />
        </shape>
    </item>

</layer-list>