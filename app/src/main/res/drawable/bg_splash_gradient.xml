<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="900dp"
                android:centerX="0.5"
                android:centerY="0.38"
                android:startColor="@color/splash_end"
                android:centerColor="@color/splash_center"
                android:endColor="@color/splash_start" />
        </shape>
    </item>

    <item>
        <shape>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#00C9A96E"
                android:endColor="@color/splash_overlay_end" />
        </shape>
    </item>

</layer-list>