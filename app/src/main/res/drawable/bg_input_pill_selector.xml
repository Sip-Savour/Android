<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/input_pill_bg_focused" />
            <corners android:radius="28dp" />
            <stroke android:width="2dp" android:color="@color/input_pill_stroke" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/input_pill_bg_disabled" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/input_pill_bg" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</selector>