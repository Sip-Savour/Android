<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#8B2942"
                android:centerColor="#B85871"
                android:endColor="#E8A5A0"
                android:type="linear" />
        </shape>
    </item>

    <!-- App icon centré -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/app_icon" />
    </item>

</layer-list>