<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#18000000"
                android:endColor="#00000000" />
            <size android:height="3dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="@color/bottom_nav_bg_start"
                android:endColor="@color/bottom_nav_bg_end" />
        </shape>
    </item>

</layer-list>