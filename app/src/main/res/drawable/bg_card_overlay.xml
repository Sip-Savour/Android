<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Couche 1 : Dégradé vertical principal bordeaux-fumé -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/weekly_overlay_start"
                android:centerColor="@color/weekly_overlay_center"
                android:endColor="@color/weekly_overlay_end" />
        </shape>
    </item>

    <!-- Couche 2 : Vignette radiale pour focaliser le regard -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="360dp"
                android:centerX="0.5"
                android:centerY="0.35"
                android:startColor="#00000000"
                android:endColor="#30100810" />
        </shape>
    </item>

</layer-list>