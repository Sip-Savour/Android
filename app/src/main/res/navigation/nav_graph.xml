<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.sipandsavour.ui.home.SplashFragment"
        android:label=""
        tools:layout="@layout/fragment_splash">

        <action
            android:id="@+id/action_splash_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out" />

        <action
            android:id="@+id/action_splash_to_auth"
            app:destination="@id/nav_auth"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out" />
    </fragment>

    <include app:graph="@navigation/nav_auth" />

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.sipandsavour.ui.home.HomeFragment"
        android:label=""
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_home_to_flavor"
            app:destination="@id/flavorSelectionFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />

        <action
            android:id="@+id/action_home_to_weekly"
            app:destination="@id/weeklyChoiceFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/advancedSearchFragment"
        android:name="com.sipandsavour.ui.selection.FlavorFragment"
        android:label=""
        tools:layout="@layout/fragment_flavor">

        <argument
            android:name="mode"
            app:argType="string"
            android:defaultValue="search" />

        <action
            android:id="@+id/action_search_to_suggestions"
            app:destination="@id/suggestionListFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/mealFragment"
        android:name="com.sipandsavour.ui.selection.MealFragment"
        android:label=""
        tools:layout="@layout/fragment_meal">

        <action
            android:id="@+id/action_meal_to_flavor"
            app:destination="@id/flavorFromMealFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />

        <action
            android:id="@+id/action_meal_to_suggestions"
            app:destination="@id/suggestionListFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/favoritesFragment"
        android:name="com.sipandsavour.ui.favorites.FavoritesFragment"
        android:label=""
        tools:layout="@layout/fragment_favorites">

        <action
            android:id="@+id/action_favorites_to_wineDetail"
            app:destination="@id/wineDetailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.sipandsavour.ui.profile.ProfileFragment"
        android:label=""
        tools:layout="@layout/fragment_profile" >
        <action
            android:id="@+id/action_profile_to_auth"
            app:destination="@id/nav_auth" />
        <action
            android:id="@+id/action_profile_to_preferences"
            app:destination="@id/preferencesFragment" />
        <action
            android:id="@+id/action_profile_to_history"
            app:destination="@id/historyFragment" />

        <action
            android:id="@+id/action_profile_to_settings"
            app:destination="@id/settingsFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.sipandsavour.ui.profile.SettingsFragment"
        android:label=""
        tools:layout="@layout/fragment_settings" />
    <fragment
        android:id="@+id/historyFragment"
        android:name="com.sipandsavour.ui.profile.HistoryFragment"
        android:label=""
        tools:layout="@layout/fragment_history">
        <action
            android:id="@+id/action_history_to_wineDetail"
            app:destination="@id/wineDetailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/flavorSelectionFragment"
        android:name="com.sipandsavour.ui.selection.FlavorFragment"
        android:label=""
        tools:layout="@layout/fragment_flavor">

        <argument
            android:name="mode"
            app:argType="string"
            android:defaultValue="match" />

        <action
            android:id="@+id/action_flavor_to_suggestions"
            app:destination="@id/suggestionListFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out" />
    </fragment>
    <fragment
        android:id="@+id/preferencesFragment"
        android:name="com.sipandsavour.ui.profile.PreferencesFragment"
        android:label=""
        tools:layout="@layout/fragment_preferences" />
    <fragment
        android:id="@+id/flavorFromMealFragment"
        android:name="com.sipandsavour.ui.selection.FlavorFragment"
        android:label=""
        tools:layout="@layout/fragment_flavor">

        <argument
            android:name="mode"
            app:argType="string"
            android:defaultValue="match" />

        <action
            android:id="@+id/action_flavorMeal_to_suggestions"
            app:destination="@id/suggestionListFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/weeklyChoiceFragment"
        android:name="com.sipandsavour.ui.result.WeeklyChoiceFragment"
        android:label=""
        tools:layout="@layout/fragment_weekly_choice" />

    <fragment
        android:id="@+id/suggestionListFragment"
        android:name="com.sipandsavour.ui.result.SuggestionListFragment"
        android:label=""
        tools:layout="@layout/fragment_suggestion_list">

        <action
            android:id="@+id/action_suggestion_to_detail"
            app:destination="@id/wineDetailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/wineDetailFragment"
        android:name="com.sipandsavour.ui.result.ResultFragment"
        android:label=""
        tools:layout="@layout/fragment_result" />

</navigation>