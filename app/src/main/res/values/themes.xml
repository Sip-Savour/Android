<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.SipSavour" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>

        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="colorOnSecondary">@color/on_secondary</item>

        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnBackground">@color/on_background</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>

        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>

        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:navigationBarColor">@color/primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/background</item>

        <item name="materialButtonStyle">@style/Widget.SipSavour.Button</item>
        <item name="textInputStyle">@style/Widget.SipSavour.TextInput</item>
        <item name="chipStyle">@style/Widget.SipSavour.Chip</item>
        <item name="materialCardViewStyle">@style/Widget.SipSavour.Card</item>
        <item name="bottomNavigationStyle">@style/Widget.SipSavour.BottomNav</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.SipSavour.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.SipSavour.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.SipSavour.LargeComponent</item>

    </style>

    <style name="Theme.SipSavour.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#6B1D32</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.SipSavour</item>
    </style>

    <style name="Theme.SipSavour.NoActionBar" parent="Theme.SipSavour">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.SipSavour.Jinx" parent="Theme.SipSavour">

        <item name="colorPrimary">#FF007F</item>
        <item name="colorPrimaryDark">#C50062</item>
        <item name="colorPrimaryVariant">#C50062</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <item name="colorSecondary">#00E5FF</item>
        <item name="colorSecondaryVariant">#00B8CC</item>
        <item name="colorOnSecondary">#000000</item>

        <item name="android:colorBackground">#09090C</item>
        <item name="colorSurface">#14141C</item>
        <item name="colorOnBackground">#00E5FF</item>
        <item name="colorOnSurface">#FFFFFF</item>

        <item name="colorSurfaceVariant">#1E1E2A</item>
        <item name="colorOnSurfaceVariant">#00B8CC</item>

        <item name="colorError">#FF3366</item>
        <item name="colorOnError">#FFFFFF</item>

        <item name="android:windowBackground">#09090C</item>
        <item name="android:statusBarColor">#09090C</item>
        <item name="android:navigationBarColor">#09090C</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="android:textColorPrimary">#FF007F</item>

    </style>

</resources>